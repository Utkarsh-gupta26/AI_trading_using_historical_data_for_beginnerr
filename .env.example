# Copy this file to ".env" and fill in your own values.
# .env is gitignored — it will never be committed.

# ── Delta Exchange (crypto account features) ────────────────────────────
# Only needed if you use the live crypto trading-account panel.
# Get these from https://www.delta.exchange (Account -> API Keys).
# IMPORTANT: the previous version of this repo had a real key+secret
# committed in plaintext in server.py. If that key is still active,
# revoke it on Delta Exchange and generate a new one before using this app.
DELTA_API_KEY=
DELTA_API_SECRET=

# ── Upstox (real NSE/BSE market data) ───────────────────────────────────
# 1. Go to https://developer.upstox.com and log in with your Upstox account.
# 2. Create a new app under "Apps".
# 3. Set the Redirect URL to exactly:  http://localhost:3000/api/upstox/callback
#    (must match UPSTOX_REDIRECT_URI below character-for-character)
# 4. Copy the API Key -> UPSTOX_CLIENT_ID, and API Secret -> UPSTOX_CLIENT_SECRET.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3000/api/upstox/callback

# ── NVIDIA Nemotron AI Model ──────────────────────────────────────────
# Get an API key from https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
